# Copy to `.env.local` for local development (never commit secrets).
# https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

# --- Site (canonical origin) ---
# Used for metadata, sitemap, robots, and JSON-LD. Defaults match production.
NEXT_PUBLIC_SITE_URL=https://theocodes.dev

# Display name (home hero, metadata).
# APP_NAME=Theodore Belo

# --- Directus (CMS) ---
# Server-side SDK / RSC fetches. In Docker, use the internal service URL (e.g. http://directus:8055).
# DIRECTUS_URL=http://directus:8055

# Browser-reachable origin for /assets/* (Next/Image, client). Required if DIRECTUS_URL is internal-only.
NEXT_PUBLIC_DIRECTUS_URL=https://admin.theocodes.dev

# If neither Directus URL is set, lib/directus-env.ts uses https://admin.theocodes.dev.

# --- CMS cache & on-demand revalidation ---
# ISR window in seconds for project data (default: 300). Daily example: 86400
# CMS_REVALIDATE_SECONDS=300

# Secret for POST /api/revalidate (?secret= or header x-revalidate-secret). Required for on-demand purge.
# REVALIDATE_SECRET=

# --- Social (optional overrides; defaults in lib/site.ts) ---
# NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/theodore-belo
# NEXT_PUBLIC_GITHUB_URL=https://github.com/theobelo25/
